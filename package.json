{
  "name": "comrade-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "COMRADE - Browser RTS Classics Monorepo",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @comrade/contracts build && pnpm --filter './apps/*' dev",
    "build": "pnpm --filter @comrade/contracts build && pnpm --filter @comrade/web build && pnpm --filter @comrade/service build && pnpm --filter @comrade/client-runtime build && pnpm --filter @comrade/pack-sdk build",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "pnpm --filter @comrade/contracts build && vitest run tests/unit",
    "test:integration": "echo 'Integration tests not yet implemented'",
    "test:e2e": "echo 'E2E tests not yet implemented'",
    "test:parity": "echo 'Parity tests not yet implemented'",
    "test:security": "echo 'Security tests not yet implemented'",
    "test:performance": "echo 'Performance tests not yet implemented'",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "typecheck": "pnpm --filter @comrade/contracts build && tsc --noEmit",
    "clean": "pnpm --filter './apps/*' clean && pnpm --filter './packages/*' clean && pnpm --filter './tools/*' clean && pnpm --filter './tests/*' clean",
    "ci": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "playwright": "1.56.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=9.15.0"
  },
  "packageManager": "pnpm@9.15.0"
}
