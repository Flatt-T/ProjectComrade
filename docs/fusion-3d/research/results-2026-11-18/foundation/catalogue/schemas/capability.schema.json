{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fusion:research:catalogue:v1:capability",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "capability"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "urn:fusion:research:catalogue:v1:common#/$defs/evidence"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "urn:fusion:research:catalogue:v1:common#/$defs/unresolved"
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "enum": [
        "gameplay",
        "environment",
        "mode",
        "objective",
        "presentation"
      ]
    },
    "state_contract": {
      "$ref": "urn:fusion:research:catalogue:v1:common#/$defs/datum"
    },
    "commands": {
      "$ref": "urn:fusion:research:catalogue:v1:common#/$defs/datum"
    },
    "tick_order": {
      "$ref": "urn:fusion:research:catalogue:v1:common#/$defs/datum"
    },
    "world_policy": {
      "$ref": "urn:fusion:research:catalogue:v1:common#/$defs/datum"
    },
    "dependency_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]*$"
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "implementation_task": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "review_task": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "support_status": {
      "enum": [
        "unknown",
        "required",
        "implemented",
        "accepted"
      ]
    },
    "fixture_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "profile_id",
    "evidence",
    "owner",
    "reviewer",
    "blockers",
    "version",
    "domain",
    "state_contract",
    "commands",
    "tick_order",
    "world_policy",
    "dependency_ids",
    "implementation_task",
    "review_task",
    "support_status",
    "fixture_ids"
  ]
}
