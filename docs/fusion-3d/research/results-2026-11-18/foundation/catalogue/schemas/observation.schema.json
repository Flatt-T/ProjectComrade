{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fusion:research:catalogue:v1:observation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "observation"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "urn:fusion:research:catalogue:v1:common#/$defs/evidence"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "urn:fusion:research:catalogue:v1:common#/$defs/unresolved"
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "subject_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]*$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "setup": {
      "type": "string",
      "minLength": 1
    },
    "map_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "expectation": {
      "$ref": "urn:fusion:research:catalogue:v1:common#/$defs/datum"
    },
    "result": {
      "$ref": "urn:fusion:research:catalogue:v1:common#/$defs/datum"
    },
    "sample_count": {
      "type": "integer",
      "minimum": 0
    },
    "interpretation": {
      "enum": [
        "source_inference",
        "direct_playback",
        "community_hypothesis",
        "fusion_choice",
        "fixture"
      ]
    },
    "independent": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "profile_id",
    "evidence",
    "owner",
    "reviewer",
    "blockers",
    "question",
    "subject_ids",
    "setup",
    "map_hash",
    "seed",
    "commands",
    "expectation",
    "result",
    "sample_count",
    "interpretation",
    "independent"
  ]
}
