    "kind": {
      "const": "entity"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "evidence": {
      "type": "array",
