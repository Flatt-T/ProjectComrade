  "cross_era_fixture_axes": [
    {
      "interaction": "resource transfer and power",
      "test": "Keep Tiberium, ore and supplies profile-specific. Check transfer, death during deposit and power-failure interactions against explicit Fusion decisions."
    },
    {
      "interaction": "air, sea and ground crossing",
      "test": "Compare hover/air/underground/ground movement with a destroyed span, repaired deck, blocked approaches and an occupied lower layer."
    },
    {
      "interaction": "control, capture and protection",
      "test": "Cross faction mind control, garrison exit, engineering, allied consent, shield and offline entry rules. Record owner, controller and visibility separately."
    },
    {
      "interaction": "transform, summon and save",
      "test": "Persist ownership, health, attachments and state through deployment, transformation, passenger death, summons and replay."
    },
    {
      "interaction": "cross-era presentation",
      "test": "Identify faction, unit role and action from silhouette and sound at combat zoom in winter, temperate and urban backgrounds; record device frame-time percentiles."
    }
  ]
